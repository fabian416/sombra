# Sombra Archive base URL (health, checkpoint, events)
VITE_ARCHIVE_URL=http://localhost:8787

# Data layer: "mock" (default) or "live".
#
#   mock — the scripted stand-in. No network beyond Freighter.
#   live — sombra-kit against the real Archive, the real RPC and the real
#          contract. Balances are read from the account's ledger entry and
#          recovery replays real events; the operations that need a proof
#          (send, merge, shield, unshield, swap) stay simulated, and every
#          receipt they return carries `simulated: true`.
#
# VITE_SOMBRA_CLIENT is accepted as the older spelling of the same flag.
VITE_CLIENT_MODE=mock

# The confidential token the live client reads and recovers against.
VITE_CT_CONTRACT_ID=CC2Z2B4X4IIFPEHTAAXSZMXVOFUFLDFQ2HVOOQUY3UTFNNKKZPEK4ZAC
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Pins the archive/RPC seam (SDK.md §12.4). Left unset, the seam sits at the
# RPC's live retention floor plus a margin — on testnet that is ~120,960
# ledgers back, so the RPC serves this whole history and the Archive's role is
# never exercised. Setting it just above the scripted history makes the Archive
# the only source for it. The code path is identical either way; only the number
# moves, and anything rendering the result must say the timescale is compressed.
#
# One past the last ledger of the demo history (scripts/deployment.json).
VITE_DEMO_SEAM_LEDGER=3954009
