# Sombra Archive configuration. Copy to `.env` and edit.

# --- Source (INDEXER.md §4 "Source") ---------------------------------------
# Any RPC that yields the complete, final event stream.
RPC_URL=https://soroban-testnet.stellar.org

# --- Contracts to index ----------------------------------------------------
# Comma-separated Soroban contract ids (C...56 chars).
#
# The default is Sombra's demo Confidential Token on testnet, deployed fresh so
# that the archive can hold its FULL history by construction (see START_LEDGER).
# Details, including the transaction that produced each event, are in
# ../scripts/deployment.json.
CONTRACT_IDS=CC2Z2B4X4IIFPEHTAAXSZMXVOFUFLDFQ2HVOOQUY3UTFNNKKZPEK4ZAC

# --- Ingestion loop --------------------------------------------------------
# Milliseconds between polls of the source.
POLL_INTERVAL_MS=5000
# Max events per getEvents page (RPC caps this; 10000 is the server maximum).
PAGE_LIMIT=200
# Ledger to start ingesting from on a cold start for a contract.
#   <int>  -> that ledger. Use the contract's DEPLOY ledger: the archive then
#             holds the contract's full history, which is what INDEXER.md §5
#             ("retain indefinitely") actually requires.
#   auto   -> the source's oldest retained ledger (getHealth().oldestLedger).
#             Convenient for development, but such an archive has never held
#             anything older than the ~7-day RPC window it exists to outlive.
#             It logs a warning and reports holds_full_history=false on
#             /v1/health, so it can never be mistaken for a conforming one.
#
# 3949779 is the deploy ledger of the CONTRACT_IDS default above.
START_LEDGER=3949779

# Ledgers requested per poll. Every scan carries an explicit endLedger so that
# coverage is claimed from what the request bounded, never from the node's
# reported head (§4).
POLL_WINDOW_LEDGERS=1000
# Ledgers of headroom above the source's retention floor when clamping a cold
# start, so the window does not slide out from under the first getEvents call.
RETENTION_MARGIN=60

# --- Storage ---------------------------------------------------------------
# SQLite file. Use an absolute path in production; `:memory:` for throwaway runs.
DB_PATH=./data/archive.db

# --- HTTP ------------------------------------------------------------------
# The wallet's VITE_ARCHIVE_URL must point here; keep the two in step.
PORT=8787
HOST=0.0.0.0
# Comma-separated allowed origins, or `*` for any (the wallet is a browser app).
CORS_ORIGIN=*

# Set to `1` to serve the API without starting the ingestion loop.
API_ONLY=0

# --- Test fixtures ---------------------------------------------------------
# `npm run seed:mock` writes an AUTHORED event history and stamps the database
# `source=seeded-fixture`. The server refuses to serve such a database unless
# this is set to 1 — a seeded archive must never look like one that ingested a
# real chain. Use it to demo the API without a chain; never for the real demo.
ALLOW_FIXTURE_DB=0
# First ledger of the synthetic history. Only read by the seeder.
MOCK_START_LEDGER=3800000
